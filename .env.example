# ==============================
# Local development environment
# ==============================

# PostgreSQL (Docker Compose + Spring Boot)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=library_management
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# Spring Boot
SERVER_PORT=8080

# JWT - Base64 of 32 random bytes. setup.ps1 generates this automatically in .env.
JWT_SECRET_BASE64=CHANGE_ME_BASE64_SECRET

# Local bootstrap admin (created only when the email does not already exist)
BOOTSTRAP_ADMIN_EMAIL=admin@libra.edu.vn
BOOTSTRAP_ADMIN_PASSWORD=Admin123
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị hệ thống

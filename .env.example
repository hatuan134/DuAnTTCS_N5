# Local development environment.
# Do not commit the real .env file.
# You normally do NOT need to edit this file: SETUP_LOCAL.cmd / RUN_ALL.cmd
# automatically create or repair .env and generate a valid JWT secret.

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=library_management
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
JWT_SECRET_BASE64=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=

# Frontend URL used in email links
FRONTEND_URL=http://localhost:5173

# SMTP (optional for local startup, required to actually send S1-02/S1-07 emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=


# BAT AI
AI_ENABLED=true
# UU TIEN GROQ, SAU DO GEMINI
AI_PROVIDER_MODE=GROQ_FIRST
# DAN API KEY GROQ VAO DAY
GROQ_API_KEY=
# MODEL CHINH
GROQ_MODEL=openai/gpt-oss-120b
# DANH SACH MODEL GROQ DU PHONG
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile

# DAN API KEY GEMINI VAO DAY
GEMINI_API_KEY=

# MODEL CHINH
GEMINI_MODEL=gemini-3.5-flash-lite

# DANH SACH MODEL GEMINI DU PHONG
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# CHO PHEP CHUYEN GROQ <-> GEMINI
AI_ALLOW_CROSS_PROVIDER_FALLBACK=true

# CHO PHEP CHUYEN NGU CANH NOI BO SANG AI
AI_ALLOW_PRIVATE_CONTEXT=true

# THOI GIAN CHO TOI THIEU KHI MODEL LOI
AI_GROQ_COOLDOWN_SECONDS=60

AI_GEMINI_COOLDOWN_SECONDS=60

# SO LAN LOI TRUOC KHI KICH HOAT COOLDOWN
AI_GROQ_FAILURE_THRESHOLD=2

AI_MODEL_FAILURE_THRESHOLD=2

# TIMEOUT CHO MOT LAN GOI MODEL
AI_TIMEOUT_SECONDS=25

# TONG THOI GIAN CHO TOAN BO CHUOI FALLBACK
AI_TOTAL_TIMEOUT_SECONDS=90

# SO TOKEN DAU RA TOI DA
AI_MAX_TOKENS=1200

# SO TOOL CALL TOI DA
AI_MAX_TOOLS=4

# KHACH CHUA DANG NHAP
AI_GUEST_REQUESTS_PER_MINUTE=6

# TAI KHOAN DA DANG NHAP
# 0 = KHONG GIOI HAN THEO PHUT
AI_USER_REQUESTS_PER_MINUTE=0

# TOAN HE THONG
# 0 = KHONG GIOI HAN THEO PHUT
AI_GLOBAL_REQUESTS_PER_MINUTE=0

# 0 = KHONG GIOI HAN SO LUOT HOI TRONG HOI THOAI
AI_MAX_TURNS_PER_CONVERSATION=0

# SO YEU CAU XU LY DONG THOI
AI_MAX_CONCURRENT=6

# Local development environment.
# Do not commit the real .env file.
# You normally do NOT need to edit this file: SETUP_LOCAL.cmd / RUN_ALL.cmd
# automatically create or repair .env and generate a valid JWT secret.

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=library_management
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8080
JWT_SECRET_BASE64=CHANGE_ME_BASE64_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@libra.edu.vn
BOOTSTRAP_ADMIN_PASSWORD=Admin123
BOOTSTRAP_ADMIN_FULL_NAME=Quan tri he thong

# Frontend URL used in email links
FRONTEND_URL=http://localhost:5173

# SMTP (optional for local startup, required to actually send S1-02/S1-07 emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

